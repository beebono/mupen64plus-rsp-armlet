# Fails the configure step when a submodule's source list no longer matches ours, so that an updated submodule cannot silently
# drop or add a translation unit. Needs ARMLET_PRSP_DIR, ARMLET_HLE_DIR, ARMLET_PRSP_CPP and ARMLET_HLE_C.

function(armlet_compare what theirs ours)
    list(SORT theirs)
    list(SORT ours)
    if(NOT "${theirs}" STREQUAL "${ours}")
        set(missing "${theirs}")
        set(extra "${ours}")
        foreach(f IN LISTS ours)
            list(REMOVE_ITEM missing "${f}")
        endforeach()
        foreach(f IN LISTS theirs)
            list(REMOVE_ITEM extra "${f}")
        endforeach()
        message(FATAL_ERROR "${what}: source list drifted from the submodule.\n  in submodule, not in armlet: ${missing}\n  in armlet, not in submodule: ${extra}")
    endif()
endfunction()

# parallel-rsp: PARALLEL_RSP_SOURCES holds the library sources; the plugin target adds parallel.cpp and m64p_plugin_entry.cpp
file(READ "${ARMLET_PRSP_DIR}/CMakeLists.txt" prsp_cmake)
string(REGEX MATCH "set\\(PARALLEL_RSP_SOURCES[^)]*\\)" block "${prsp_cmake}")
if(NOT block)
    message(FATAL_ERROR "check_sources: no PARALLEL_RSP_SOURCES list in the parallel-rsp CMakeLists.txt")
endif()
string(REGEX MATCHALL "[A-Za-z0-9_/.-]+\\.cpp" theirs "${block}")
armlet_compare("parallel-rsp" "${theirs}" "${ARMLET_PRSP_CPP}")
if(NOT prsp_cmake MATCHES "MODULE \\$\\{PARALLEL_RSP_SOURCES\\} parallel\\.cpp m64p_plugin_entry\\.cpp")
    message(FATAL_ERROR "parallel-rsp: the plugin target is no longer PARALLEL_RSP_SOURCES + parallel.cpp + m64p_plugin_entry.cpp")
endif()

# rsp-hle: SOURCE in projects/unix/Makefile (the line and its backslash continuations)
file(READ "${ARMLET_HLE_DIR}/projects/unix/Makefile" mk)
string(FIND "${mk}" "\nSOURCE = " start)
if(start EQUAL -1)
    message(FATAL_ERROR "check_sources: no SOURCE list in the rsp-hle Makefile")
endif()
string(SUBSTRING "${mk}" ${start} -1 block)
string(FIND "${block}" "\n\n" end)
string(SUBSTRING "${block}" 0 ${end} block)
string(REGEX MATCHALL "[A-Za-z0-9_]+\\.c" theirs "${block}")
list(REMOVE_ITEM theirs plugin.c)
armlet_compare("rsp-hle" "${theirs}" "${ARMLET_HLE_C}")
